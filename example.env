# Example env file for all game server setups in this repo.
# Copy to .env (gitignored) and edit - or run `python main.py` from the repo
# root and it will generate/update .env for you.
#
# One .env at the repo root is shared by every game's docker-compose.yml
# (each one loads it via env_file: ../.env). Only the variables a game's
# image reads matter for that game.

# --- Plutonium T6 Zombies (plutonium_t6_zombies/) ---

# Online mode settings
SERVER_KEY=   # required for online mode, get it from https://plutonium.pw
LAN_MODE=true # set to "true" to run in LAN mode instead

# Common settings
SERVER_MODE=Zombie    # "Zombie" or "Multiplayer"
SERVER_MAX_CLIENTS=8  # 1-8, leave blank for default (4)
SERVER_RCON_PASSWORD= # leave blank for default (admin)
SERVER_PASSWORD=      # leave blank for no password
SERVER_PORT=4976      # must match the udp/tcp port mapping in docker-compose.yml
ADMIN_PORT=1624       # must match the tcp port mapping in docker-compose.yml

# Remote admin: open the in-game console (~) and use "/rcon login <password>"
# then "/rcon <command>". See docs/plutonium-t6-rcon.md.

# LAN mode only
# SERVER_MAP_ROTATION=

# --- Satisfactory Server (satisfactory_server/) ---

# Connection/messaging ports (7777 tcp+udp, 8888 tcp) are hardcoded in the
# compose file; only the settings below are tunable here.
MAXPLAYERS=8    # max players (default 4)
PUID=1000       # owner UID for /config (wolveix default, keep 1000)
PGID=1000       # owner GID for /config (wolveix default, keep 1000)
STEAMBETA=false # set "true" for the experimental branch

# Optional Satisfactory tweaks (image defaults shown) - uncomment to change:
# AUTOSAVENUM=5                     # rotating autosave files
# DISABLESEASONALEVENTS=false       # disable the FICSMAS event
# LOG=false                         # keep Satisfactory logs across restarts
# MAXOBJECTS=2162688                # in-game object limit
# MAXTICKRATE=30                    # max sim tick rate
# SKIPUPDATE=false                  # avoid auto-updating on container start
# TIMEOUT=30                        # client timeout in seconds
# SERVERSTREAMING=true              # toggle asset streaming
# DEBUG=false
